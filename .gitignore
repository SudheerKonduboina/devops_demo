# ─────────────────────────────────────────────────────────────────
# InfraWatch — .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Testing ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ── Type checking ─────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Virtual environments ──────────────────────────────────────────
.venv/
venv/
ENV/
env/
.env.bak

# ── ⚠️ SECRETS — NEVER COMMIT THESE ──────────────────────────────
.env
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# ── Logs ──────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Docker ────────────────────────────────────────────────────────
.docker/

# ── IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Backup archives ───────────────────────────────────────────────
*.tar.gz
*.zip
*.bak
