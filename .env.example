# ============================================================
# InfraWatch — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to Git — it contains secrets!
# ============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME=InfraWatch
APP_VERSION=1.0.0
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-long-random-string-in-production

# ── Flask ─────────────────────────────────────────────────────
FLASK_DEBUG=false
PORT=5000

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/infrawatch.log

# ── Monitoring Daemon (monitoring/health_monitor.py) ──────────
MONITOR_API_URL=http://localhost/healthz
MONITOR_INTERVAL=60
CPU_THRESHOLD=85.0
MEMORY_THRESHOLD=85.0
DISK_THRESHOLD=90.0

# ── Alert Email (optional — leave blank to disable) ───────────
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
